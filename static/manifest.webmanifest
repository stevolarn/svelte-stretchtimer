{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "Stretch & Recovery",
  "short_name": "Stretch & Rec",
  "description": "Phone-first offline app for stretching, mobility and strength routines, with a pain journal, recovery tracking, streaks and audio guidance.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f4f4ef",
  "theme_color": "#f4f4ef",
  "categories": ["health", "fitness", "lifestyle", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Routines",
      "short_name": "Routines",
      "description": "Browse and start stretching routines",
      "url": "/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "2-minute micro-break",
      "short_name": "Micro-break",
      "description": "Start a quick random set of desk-friendly RSI moves",
      "url": "/player/micro-break",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Streak",
      "short_name": "Streak",
      "description": "See your streak and stretch calendar",
      "url": "/stats",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
